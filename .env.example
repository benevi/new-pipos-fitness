# Copia este fichero a apps/api/.env y rellena los valores.
# La API valida estas variables con Zod al arrancar (apps/api/src/config/env.ts)
# y NO arranca si falta alguna obligatoria o es inválida. No hay secretos por defecto.

NODE_ENV=development
PORT=3000

# Obligatoria. Con docker compose: postgresql://pipos:pipos@localhost:5432/pipos_dev
DATABASE_URL=postgresql://pipos:pipos@localhost:5432/pipos_dev
# Solo para `pnpm --filter @pipos/api prisma:diff` (comprobar deriva schema ↔ migraciones).
DATABASE_URL_SHADOW=postgresql://pipos:pipos@localhost:5432/pipos_shadow

# Obligatoria, mínimo 32 caracteres. Genera una con: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Vida del access token en segundos (por defecto 900 = 15 min).
JWT_ACCESS_EXPIRES_IN=900
# Vida del refresh token en días (por defecto 30).
REFRESH_TOKEN_TTL_DAYS=30
# Ventana (s) en la que reenviar un refresh token recién rotado es una carrera benigna:
# 401 AUTH_REFRESH_RACE sin revocar la sesión. Fuera de ella, la reutilización revoca todo.
REFRESH_REUSE_GRACE_SECONDS=10

# Orígenes de navegador permitidos (lista separada por comas). Vacío = ninguno.
# La app móvil no necesita CORS.
CORS_ORIGINS=http://localhost:3000

# Logs JSON (una línea por evento, con requestId). Nunca incluyen PII ni datos de salud.
LOG_LEVEL=info

# Rate limiting (true por defecto; no se puede desactivar en producción).
THROTTLE_ENABLED=true
# Proxies de confianza delante de la API (0 = se ignora X-Forwarded-For). En producción, los del
# hosting (normalmente 1). Nunca más de los reales: permitiría falsificar la IP del cliente.
TRUST_PROXY_HOPS=0
# Almacén de contadores del rate limiting: postgres (compartido entre réplicas; por defecto en
# producción) o memory (por proceso; por defecto en desarrollo y tests).
THROTTLE_STORE=memory

# Opcional: DSN de Sentry (o similar) para monitorización de errores.
SENTRY_DSN=
