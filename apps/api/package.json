{
  "name": "@pipos/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "lint": "eslint \"{src,prisma,scripts}/**/*.ts\" prisma.config.ts --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test:e2e": "vitest run -c vitest.e2e.config.mts",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "analytics:rebuild": "tsx scripts/analytics-rebuild.ts",
    "audit:cleanup": "tsx scripts/audit-cleanup.ts",
    "openapi:generate": "tsx scripts/openapi.ts write",
    "openapi:check": "tsx scripts/openapi.ts check"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@pipos/catalog": "workspace:*",
    "@pipos/contracts": "workspace:*",
    "@pipos/engine-rules": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.2",
    "@swc/core": "^1.7.26",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "^4.0.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.14.0",
    "prisma": "^7.10.1",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
