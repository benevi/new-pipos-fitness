// Modelo de datos v1 — ver docs/MODELO_DATOS.md (fuente de verdad) y docs/adr/0009.
// Lo que Prisma no expresa (CHECK, índices parciales) está en SQL crudo al final de
// prisma/migrations/*_init/migration.sql. Los valores de enum coinciden 1:1 con
// packages/contracts (lo comprueba src/contracts-enums.spec.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  user
  admin
}

enum Locale {
  es
  en
}

enum Sex {
  male
  female
  other
}

enum TrainingGoal {
  strength
  hypertrophy
  general_health
  fat_loss
  muscular_endurance
}

enum TrainingLevel {
  beginner
  intermediate
  advanced
}

enum ActivityLevel {
  sedentary_light
  active
  vigorous
}

enum Equipment {
  bodyweight
  barbell
  ez_bar
  trap_bar
  dumbbell
  kettlebell
  weight_plate
  bench
  squat_rack
  cable
  machine
  smith_machine
  pull_up_bar
  dip_station
  gymnastic_rings
  suspension_trainer
  resistance_band
  medicine_ball
  plyo_box
}

enum BodyZone {
  shoulder
  elbow
  wrist
  lumbar
  hip
  knee
  ankle
}

enum Muscle {
  chest
  front_delts
  side_delts
  rear_delts
  lats
  upper_back
  traps
  biceps
  triceps
  forearms
  abs
  obliques
  lower_back
  glutes
  quads
  hamstrings
  adductors
  abductors
  calves
}

enum VolumeGroup {
  chest
  back
  shoulders
  biceps
  triceps
  quads
  hamstrings
  glutes
  calves
  core
}

enum MuscleRole {
  primary
  secondary
}

enum MovementPattern {
  squat
  hinge
  lunge
  horizontal_push
  vertical_push
  horizontal_pull
  vertical_pull
  elbow_flexion
  elbow_extension
  shoulder_isolation
  knee_extension
  knee_flexion
  hip_isolation
  calf_raise
  core_anti_extension
  core_anti_rotation
  core_flexion
  carry
}

enum LoadType {
  weighted
  unweighted
}

enum RiskLevel {
  caution
  avoid
}

enum ExercisePreferenceKind {
  banned
  favourite
}

enum MediaKind {
  youtube
  image
}

enum ModerationStatus {
  pending
  approved
  rejected
  unavailable
}

enum ConsentPurpose {
  health_data_processing
}

enum ConsentAction {
  granted
  withdrawn
}

enum RefreshTokenRevokeReason {
  rotated
  logout
  reuse_detected
  password_changed
  account_deleted
  admin
}

enum PlanStatus {
  active
  archived
}

enum SessionKind {
  full_body
  upper
  lower
  push
  pull
  legs
}

enum ExerciseRole {
  main
  secondary
  accessory
  core
}

enum WorkoutStatus {
  in_progress
  completed
  abandoned
}

// ─────────────────────────────────────────────────────────────
// IDENTIDAD Y AUTH
// ─────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String
  emailNormalized String   @unique
  passwordHash    String
  role            Role     @default(user)
  locale          Locale   @default(es)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  refreshTokens       RefreshToken[]
  trainingProfile     TrainingProfile?
  exercisePreferences UserExercisePreference[]
  consentEvents       ConsentEvent[]
  trainingPlans       TrainingPlan[]
  workoutSessions     WorkoutSession[]
  setLogs             SetLog[]
  substitutions       WorkoutSubstitution[]
  e1rmHistory         ExerciseE1rm[]
  weeklyMuscleVolume  WeeklyMuscleVolume[]
  weeklyGroupVolume   WeeklyGroupVolume[]
  weeklyAdherence     WeeklyAdherence[]
  exerciseNotes       UserExerciseNote[]
  planOverrides       PlanExerciseOverride[]
  trainingBreaks      TrainingBreak[]
  moderatedMedia      ExerciseMedia[]          @relation("MediaModeratedBy")
}

model RefreshToken {
  id            String                    @id @default(uuid()) @db.Uuid
  userId        String                    @db.Uuid
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// = id del primer token del login; se hereda en cada rotación.
  familyId      String                    @db.Uuid
  /// SHA-256 (hex) del token opaco; nunca el token en claro.
  tokenHash     String                    @unique
  expiresAt     DateTime                  @db.Timestamptz(3)
  createdAt     DateTime                  @default(now()) @db.Timestamptz(3)
  rotatedAt     DateTime?                 @db.Timestamptz(3)
  revokedAt     DateTime?                 @db.Timestamptz(3)
  revokedReason RefreshTokenRevokeReason?
  replacedById  String?                   @unique @db.Uuid
  replacedBy    RefreshToken?             @relation("Rotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces      RefreshToken?             @relation("Rotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// PERFIL DE ENTRENAMIENTO (1:1 con User)
// ─────────────────────────────────────────────────────────────

model TrainingProfile {
  userId            String         @id @db.Uuid
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal              TrainingGoal
  level             TrainingLevel
  daysPerWeek       Int            @db.SmallInt
  minutesPerSession Int            @db.SmallInt
  equipment         Equipment[]
  priorityMuscles   Muscle[]
  /// Zona horaria IANA del usuario: fija los límites de semana de la analítica.
  timezone          String         @db.VarChar(64)
  activityLevel     ActivityLevel?
  // ── categoría especial (art. 9): solo con consentimiento vigente ──
  limitations       BodyZone[]     @default([])
  weightKg          Decimal?       @db.Decimal(5, 2)
  heightCm          Decimal?       @db.Decimal(5, 1)
  // ── datos personales ordinarios ──
  /// Días de entreno preferidos (ISO 1 = lunes … 7 = domingo), como mucho `daysPerWeek`. No es
  /// una entrada del motor: solo recordatorio local y «hoy toca» (idea 6, ADR-0013).
  trainingWeekdays  Int[]          @default([]) @db.SmallInt
  birthYear         Int?           @db.SmallInt
  sex               Sex?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
}

model UserExercisePreference {
  userId     String                 @db.Uuid
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String                 @db.Uuid
  exercise   Exercise               @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  kind       ExercisePreferenceKind
  createdAt  DateTime               @default(now()) @db.Timestamptz(3)

  @@id([userId, exerciseId])
  @@index([exerciseId])
}

/// Pausa planificada (vacaciones…; idea 6, ADR-0013). Fechas locales del usuario, ambas
/// incluidas, como mucho 60 días. Sin motivo (sería dato de salud). Excluye sus días de la
/// adherencia y de la ausencia que baja la carga (PROGRAMACION.md §16.18).
model TrainingBreak {
  id        String   @id @default(uuid()) @db.Uuid
  /// Idempotencia offline (ADR-0007).
  clientId  String   @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, clientId])
  @@index([userId, startsOn])
}

/// Nota fija del usuario para un ejercicio (ajustes de máquina, agarre…; idea 2, ADR-0013).
/// Texto libre: puede contener datos de salud si el usuario los escribe. Va en la exportación,
/// se borra con la cuenta y nunca se registra en logs (docs/SECURITY.md).
model UserExerciseNote {
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId      String   @db.Uuid
  exercise        Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  text            String   @db.VarChar(280)
  /// Reloj del cliente: última escritura gana (ADR-0007).
  clientUpdatedAt DateTime @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@id([userId, exerciseId])
  @@index([exerciseId])
}

/// Registro append-only. Estado vigente = último evento por (userId, purpose).
/// Sin IP ni user-agent (minimización, RGPD art. 5.1.c): la prueba del consentimiento es
/// el evento autenticado con la versión y el hash del texto mostrado.
model ConsentEvent {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose       ConsentPurpose
  action        ConsentAction
  policyVersion String         @db.VarChar(32)
  /// SHA-256 del texto exacto mostrado.
  textHash      String         @db.Char(64)
  locale        Locale
  occurredAt    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose, occurredAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────
// CATÁLOGO DE EJERCICIOS (seed desde @pipos/catalog; borrado lógico)
// ─────────────────────────────────────────────────────────────

model SubstitutionGroup {
  id        String     @id @default(uuid()) @db.Uuid
  key       String     @unique @db.VarChar(64)
  exercises Exercise[]
}

model Exercise {
  id                  String             @id @default(uuid()) @db.Uuid
  slug                String             @unique @db.VarChar(96)
  nameEs              String
  nameEn              String
  descriptionEs       String?
  descriptionEn       String?
  movementPattern     MovementPattern
  isCompound          Boolean
  isUnilateral        Boolean            @default(false)
  minLevel            TrainingLevel
  equipment           Equipment[]
  loadType            LoadType
  substitutionGroupId String?            @db.Uuid
  substitutionGroup   SubstitutionGroup? @relation(fields: [substitutionGroupId], references: [id], onDelete: SetNull)
  cuesEs              String[]           @default([])
  cuesEn              String[]           @default([])
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?          @db.Timestamptz(3)

  muscles       ExerciseMuscle[]
  riskTags      ExerciseRiskTag[]
  media         ExerciseMedia[]
  planExercises PlanExercise[]
  setLogs       SetLog[]
  substitutions WorkoutSubstitution[]
  e1rmHistory   ExerciseE1rm[]
  preferences   UserExercisePreference[]
  userNotes     UserExerciseNote[]
  planOverrides PlanExerciseOverride[]

  @@index([movementPattern])
  @@index([substitutionGroupId])
  @@index([equipment], type: Gin)
}

model ExerciseMuscle {
  exerciseId String     @db.Uuid
  exercise   Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscle     Muscle
  role       MuscleRole
  fraction   Decimal    @db.Decimal(3, 2)

  @@id([exerciseId, muscle])
  @@index([muscle, role])
}

model ExerciseRiskTag {
  exerciseId String    @db.Uuid
  exercise   Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  zone       BodyZone
  level      RiskLevel

  @@id([exerciseId, zone])
  @@index([zone])
}

model ExerciseMedia {
  id               String           @id @default(uuid()) @db.Uuid
  exerciseId       String           @db.Uuid
  exercise         Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  kind             MediaKind
  externalId       String?          @db.VarChar(64)
  url              String?
  channelName      String?
  startSeconds     Int?
  endSeconds       Int?
  locale           Locale?
  isPrimary        Boolean          @default(false)
  moderationStatus ModerationStatus @default(pending)
  moderatedById    String?          @db.Uuid
  moderatedBy      User?            @relation("MediaModeratedBy", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt      DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)

  @@index([exerciseId, moderationStatus])
  @@index([moderationStatus, createdAt])
}

// ─────────────────────────────────────────────────────────────
// PLANES (versionados, inmutables por versión). userId desnormalizado
// para imponer en BD, con FK compuestas, que todo cuelga del mismo usuario.
// ─────────────────────────────────────────────────────────────

model TrainingPlan {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    PlanStatus    @default(active)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  versions  PlanVersion[]

  @@unique([id, userId])
  @@index([userId, status])
}

model PlanVersion {
  id             String        @id @default(uuid()) @db.Uuid
  planId         String        @db.Uuid
  userId         String        @db.Uuid
  plan           TrainingPlan  @relation(fields: [planId, userId], references: [id, userId], onDelete: Cascade)
  version        Int
  engineVersion  String        @db.VarChar(32)
  objectiveScore Float
  mesocycleWeeks Int           @db.SmallInt
  /// Explicación estructurada del motor (split, rationale, warnings, volumen, score).
  rationale      Json
  /// Perfil usado (puede contener datos art. 9; se redacta al retirar el consentimiento).
  inputSnapshot  Json
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  sessions       PlanSession[]

  @@unique([planId, version])
  @@unique([id, userId])
  @@index([userId, createdAt(sort: Desc)])
}

model PlanSession {
  id               String           @id @default(uuid()) @db.Uuid
  planVersionId    String           @db.Uuid
  userId           String           @db.Uuid
  planVersion      PlanVersion      @relation(fields: [planVersionId, userId], references: [id, userId], onDelete: Cascade)
  dayIndex         Int              @db.SmallInt
  order            Int              @db.SmallInt
  kind             SessionKind
  name             String
  targetMinutes    Int              @db.SmallInt
  estimatedMinutes Float
  rationale        Json?
  exercises        PlanExercise[]
  workoutSessions  WorkoutSession[]

  @@unique([planVersionId, order])
  @@unique([planVersionId, dayIndex])
  @@unique([id, userId])
}

model PlanExercise {
  id                    String                @id @default(uuid()) @db.Uuid
  planSessionId         String                @db.Uuid
  planSession           PlanSession           @relation(fields: [planSessionId], references: [id], onDelete: Cascade)
  exerciseId            String                @db.Uuid
  exercise              Exercise              @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order                 Int                   @db.SmallInt
  role                  ExerciseRole
  sets                  Int                   @db.SmallInt
  repMin                Int                   @db.SmallInt
  repMax                Int                   @db.SmallInt
  targetRir             Int                   @db.SmallInt
  restSeconds           Int                   @db.SmallInt
  initialLoadKg         Decimal?              @db.Decimal(6, 2)
  initialLoadIsEstimate Boolean               @default(true)
  /// Rampa de aproximación [{ reps, loadPct }] calculada por el motor.
  warmupSets            Json
  estimatedMinutes      Float
  rationale             Json?
  setLogs               SetLog[]
  substitutions         WorkoutSubstitution[]
  override              PlanExerciseOverride?

  @@unique([planSessionId, order])
  @@index([exerciseId])
}

/// Cambio de ejercicio fijado por el usuario para un hueco del plan (idea 3, ADR-0013). La
/// versión del plan es inmutable: el cambio vive aparte y se hereda al generar la siguiente
/// versión si sigue siendo válido (motor: resolvePins).
model PlanExerciseOverride {
  planExerciseId String       @id @db.Uuid
  planExercise   PlanExercise @relation(fields: [planExerciseId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId     String       @db.Uuid
  exercise       Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([exerciseId])
}

// ─────────────────────────────────────────────────────────────
// REGISTRO DE ENTRENAMIENTOS (idempotente por clientId, ADR-0007)
// ─────────────────────────────────────────────────────────────

model WorkoutSession {
  id              String                @id @default(uuid()) @db.Uuid
  clientId        String                @db.Uuid
  userId          String                @db.Uuid
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  planSessionId   String                @db.Uuid
  planSession     PlanSession           @relation(fields: [planSessionId, userId], references: [id, userId], onDelete: NoAction)
  status          WorkoutStatus         @default(in_progress)
  /// Ajuste elegido al empezar (idea 4, ADR-0013): minutos disponibles (null = sin límite) y
  /// volumen reducido. Solo el modo, nunca el motivo (no es dato de salud).
  adjustedMinutes Int?                  @db.SmallInt
  reducedVolume   Boolean               @default(false)
  startedAt       DateTime              @db.Timestamptz(3)
  completedAt     DateTime?             @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  setLogs         SetLog[]
  substitutions   WorkoutSubstitution[]
  e1rmEntries     ExerciseE1rm[]

  @@unique([userId, clientId])
  @@unique([id, userId])
  @@index([userId, startedAt(sort: Desc)])
  @@index([planSessionId])
}

model SetLog {
  id               String         @id @default(uuid()) @db.Uuid
  clientId         String         @db.Uuid
  userId           String         @db.Uuid
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSessionId String         @db.Uuid
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId, userId], references: [id, userId], onDelete: Cascade)
  planExerciseId   String?        @db.Uuid
  planExercise     PlanExercise?  @relation(fields: [planExerciseId], references: [id], onDelete: NoAction)
  exerciseId       String         @db.Uuid
  exercise         Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  setIndex         Int            @db.SmallInt
  reps             Int            @db.SmallInt
  loadKg           Decimal        @db.Decimal(6, 2)
  rir              Int?           @db.SmallInt
  isWarmup         Boolean        @default(false)
  /// Reloj del cliente: cuándo se hizo la serie.
  completedAt      DateTime       @db.Timestamptz(3)
  /// Reloj del cliente: última edición (última escritura gana, ADR-0007).
  clientUpdatedAt  DateTime       @db.Timestamptz(3)
  /// Borrado lógico (la cola offline puede reenviar una serie borrada).
  deletedAt        DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([userId, clientId])
  @@index([workoutSessionId, exerciseId, setIndex])
  @@index([userId, exerciseId, completedAt(sort: Desc)])
  @@index([planExerciseId])
}

/// Cambio de ejercicio dentro de un entrenamiento (CUJ-4). Uno por hueco del plan.
model WorkoutSubstitution {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSessionId String         @db.Uuid
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId, userId], references: [id, userId], onDelete: Cascade)
  planExerciseId   String         @db.Uuid
  planExercise     PlanExercise   @relation(fields: [planExerciseId], references: [id], onDelete: NoAction)
  exerciseId       String         @db.Uuid
  exercise         Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([workoutSessionId, planExerciseId])
  @@index([userId])
  @@index([planExerciseId])
  @@index([exerciseId])
}

// ─────────────────────────────────────────────────────────────
// ANALÍTICA (calculada al escribir, misma transacción; ADR-0008)
// Proyecciones reconstruibles desde SetLog (pnpm analytics:rebuild).
// ─────────────────────────────────────────────────────────────

model ExerciseE1rm {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId       String         @db.Uuid
  exercise         Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  workoutSessionId String         @db.Uuid
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  performedOn      DateTime       @db.Date
  e1rmKg           Decimal        @db.Decimal(6, 2)
  sourceSetLogId   String?        @db.Uuid
  formulaVersion   String         @db.VarChar(16)
  computedAt       DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([userId, exerciseId, workoutSessionId])
  @@index([userId, exerciseId, performedOn(sort: Desc)])
  @@index([workoutSessionId])
  @@index([exerciseId])
}

model WeeklyMuscleVolume {
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Lunes ISO en la zona horaria del usuario.
  weekStart      DateTime @db.Date
  muscle         Muscle
  effectiveSets  Decimal  @db.Decimal(6, 2)
  tonnageKg      Decimal  @db.Decimal(10, 2)
  formulaVersion String   @db.VarChar(16)
  computedAt     DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, weekStart, muscle])
}

/// Series efectivas por grupo de volumen con la regla del motor: por serie, la máxima
/// fracción de los músculos del ejercicio en ese grupo (PROGRAMACION.md §16.1). No se puede
/// derivar de WeeklyMuscleVolume (que suma por músculo), por eso es una proyección propia.
model WeeklyGroupVolume {
  userId         String      @db.Uuid
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Lunes ISO en la zona horaria del usuario.
  weekStart      DateTime    @db.Date
  group          VolumeGroup
  effectiveSets  Decimal     @db.Decimal(6, 2)
  formulaVersion String      @db.VarChar(16)
  computedAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@id([userId, weekStart, group])
}

model WeeklyAdherence {
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart         DateTime @db.Date
  plannedSessions   Int      @db.SmallInt
  completedSessions Int      @db.SmallInt
  plannedSets       Int      @db.SmallInt
  completedSets     Int      @db.SmallInt
  planVersionId     String?  @db.Uuid
  computedAt        DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, weekStart])
}
