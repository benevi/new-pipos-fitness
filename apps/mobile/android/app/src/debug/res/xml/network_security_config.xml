<?xml version="1.0" encoding="utf-8"?>
<!-- Solo para builds debug. Release no incluye este fichero y por tanto
     exige HTTPS (cleartextTrafficPermitted=false por defecto en API 28+). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
