      "multer@<2.5.0": "^2.5.0",
      "body-parser@<1.20.9": "^1.20.9",
      "path-to-regexp@<0.1.13": "~0.1.13",
      "proxy-addr@<2.0.8": "^2.0.8",
      "lodash@<4.18.0": "^4.18.0",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5"
