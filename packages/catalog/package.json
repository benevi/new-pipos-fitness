{
  "name": "@pipos/catalog",
  "version": "1.0.0",
  "private": true,
  "description": "Catálogo versionado de ejercicios (seed revisado por PR, ADR-0005)",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./data/exercises.json": "./data/exercises.json"
  },
  "files": [
    "dist",
    "data",
    "media"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src scripts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=verbose",
    "media:check": "tsc -p tsconfig.build.json && node dist/scripts/media-check.js"
  },
  "dependencies": {
    "@pipos/contracts": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
