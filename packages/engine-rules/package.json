{
  "name": "@pipos/engine-rules",
  "version": "2.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src scripts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "examples": "tsx scripts/examples.ts"
  },
  "dependencies": {
    "@pipos/contracts": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@pipos/catalog": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
